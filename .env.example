# Copy to .env.local for local development. Never commit real secrets.
# Database (configure before enabling persistent orders/inventory)
DATABASE_URL=
# Authentication
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Payment provider: select and configure a real provider before accepting payments
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
# Shipping provider
SHIPPING_PROVIDER=
SHIPPING_API_KEY=
# Object storage for customer design references and delivered files
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=